	]
	quest.4AAF730F2A6A96E2.quest_subtitle: "Elmo com chifres"
	quest.4B0217A8DB07F15F.quest_desc: ["Há muitos gêiseres lá dentro que podem transformar certos itens, como transformar um crânio em um Crânio de Wither. Consulte o JEI para detalhes."]
	quest.4B0217A8DB07F15F.quest_subtitle: "Quão fundo é o leito do oceano"
	quest.4B0217A8DB07F15F.title: "Vá até o Abismo"
	quest.4B75015F91F5714D.quest_desc: ["O guarda da prisão que vigia os criminosos mais cruéis; você terá sorte se encontrá-lo"]
