	quest.1D870390E22D0E28.quest_subtitle: "Quero uma sopa"
	quest.1DE8784B7276EDA8.title: "&6【Missão Secundária】&rMais forte ainda!"
	quest.1DF55B2C88B9B888.quest_desc: [
		"Capacidade de beber poções mais rápido"
		"&6&lBeber Rápido【Desbloquear Codex】"
		"{image:ablazeaqzlcz:textures/ftb/curios/plastic_drinking_hat.png width:50 height:80 align:left}"
	]
	quest.1DF55B2C88B9B888.quest_subtitle: "Uma bocada abafada"
	quest.1E2728F6C84FFB35.quest_desc: ["Esta pedra pode ser encontrada na superfície e reaparece ao redor de fontes termais."]
	quest.1E2728F6C84FFB35.quest_subtitle: "Mina muito quente"
	quest.1E2728F6C84FFB35.title: "Minério ao lado da fonte termal"
	quest.1E58DB775CD0CE1E.quest_subtitle: "【Domínio】"
	quest.1E58DB775CD0CE1E.title: "&6【Avançado】&fObtenha a Habilidade Única Adaptabilidade"
	quest.1E7A25799F815ABA.quest_desc: [
		"Quando o anão recebe a profissão de lenhador, ele volta a derrubar árvores e as replanta automaticamente. Ao terminar o trabalho, vai até a caixa mais próxima e guarda a madeira nela."
		"Portanto, podemos cercar uma fazenda de árvores, colocar várias estações de trabalho de corte + caixas dentro dela, e teremos uma fazenda de madeira totalmente automática."
		""
		"&6Observação: a regra npcWorking vem desativada por padrão, você precisa ativá-la você mesmo com /gamerule npcWorking true"
		"&4Se essa regra estiver ativada e houver anões demais, o TPS cairá para 10!"
	]
	quest.1E7A25799F815ABA.quest_subtitle: "Serraria totalmente automática"
	quest.1E7A25799F815ABA.title: "Como você ousa roubar madeira de um lenhador!"
	quest.1EDD37632534A093.title: "Aracne"
	quest.1EEA7724FA3BB72C.quest_desc: [
