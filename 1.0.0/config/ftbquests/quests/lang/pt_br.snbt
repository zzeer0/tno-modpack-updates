	]
	quest.1F894D1554FABD87.quest_subtitle: "Parkour Subaquático"
	quest.1FA401913848D8B4.quest_desc: "&6Tem 80% de chance de ser dropado por Rimuru. &rSe você tiver o Rei da Gula, consumir 10 destes permite travar esta Habilidade Suprema na tela de \"Trava\", impedindo que seja perdida pela reencarnação."
	quest.206401394C062679.quest_desc: ["Uma prisão na tundra que pode ser encontrada usando o Olho Amaldiçoado."]
	quest.206401394C062679.quest_subtitle: "prisão siberiana"
