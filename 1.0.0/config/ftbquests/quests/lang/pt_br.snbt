	quest.234F14E5F778ADE7.title: "Garrafa Mágica de Água Comum"
	quest.236E81CDDEEA8615.quest_subtitle: "Como eu volto?"
	quest.23733860811BDA2B.quest_desc: [
		"&6EP padrão: 0"
		"&6Matar criaturas aumenta o EP, mas as armas não podem evoluir."
	]
	quest.23CADA6DEFB8211D.quest_desc: "Pode ser encontrado em vilas de Homens-Lagarto, ou obtido matando criaturas como o Dragão do Fim"
	quest.23CADA6DEFB8211D.quest_subtitle: "Como Obter"
	quest.23EA140A74800390.quest_desc: [
		"Você precisa recuperar vida enquanto luta contra um Chefe estando com sua própria vida abaixo de 25% do máximo, e o Chefe &lprecisa atender a:"
		"- Ter pelo menos 400 mil de EP"
		"- Valor de armadura de pelo menos 40 pontos (ícone de escudo)"
		"- Vida atual em 50% ou menos"
		"O gatilho ocorre automaticamente quando as condições são atendidas."
		""
		"&lObservação: o Chefe precisa ser do Tensura ou da série vanilla original."
	]
	quest.23EA140A74800390.quest_subtitle: "[Clique para entregar a missão depois de obter o ovo de herói]"
	quest.23EA140A74800390.title: "&6【Linha do Herói】&rHerói?"
	quest.2407E305A960BE43.quest_desc: "Derrote Feldway para obter."
	quest.2407E305A960BE43.quest_subtitle: "Requisitos↓"
	quest.2407E305A960BE43.title: "&6【Avançado】&fHabilidade Suprema Asmoday"
	quest.24A42438DA227224.quest_desc: [
		"&6Teclas mais usadas do TenSura:"
		"Painel pessoal: tecla B&b(vincular Habilidade, ver status)"
		"Habilidade racial: tecla R&b(algumas raças têm habilidades, outras não)"
		"Usar Habilidade: teclas Z, X, C — ALT+tecla correspondente alterna o modo"
		"&6Observação: algumas Habilidades podem alternar para o submodo usando Shift+tecla correspondente"
		""
		"Esquivar/descer da montaria: tecla V"
		"Nomeação de criaturas: tecla N&b(algumas criaturas podem ser nomeadas, outras não, e é preciso EP suficiente)"
		""
		"&6Outras teclas muito usadas:"
		"Abrir mochila: tecla H&b(mochila refinada)"
		"Abrir o mapa grande: tecla M"
		"Corte de árvores em cadeia: Shift + agachar + clique esquerdo para cortar"
	]
	quest.24A42438DA227224.quest_subtitle: "【Conteúdo obrigatório】"
	quest.24A44C95A35D658D.quest_desc: [
		"Você pode começar verificando se o machado ou a faca na sua mão tem um valor de EP (também chamado de \"EP\")."
		""
		"&6O EP se recupera automaticamente a cada segundo, então é como ter durabilidade infinita!"
	]
