	quest.48345B3536C27D98.quest_desc: [
		"Uma vila construída sobre um pântano de mangue; eles gostam de ficar em ambientes úmidos."
		"{image:ablazeaqzlcz:textures/ftb/lizardmen_village.png width:130 height:75 align:center}"
	]
	quest.48345B3536C27D98.quest_subtitle: "Habitat dos Homens-Lagarto"
	quest.48345B3536C27D98.title: "tribo do pântano"
	quest.4835EBAC6D933CDB.quest_desc: [
		"Floresta Antiga: uma área ecológica rara e perigosa, onde a concentração do fluxo de Magículos no ar é quarenta vezes maior que a do ambiente normal.&2&lHerbalistas também ficarão satisfeitos em descobrir que há um pouco mais de ervas de Hipokute aqui do que em outros lugares.&r"
		"{image:ablazeaqzlcz:textures/ftb/ancient_forest.png width:200 height:100 align:center}"
		"&6Atenção: algumas árvores enormes escondem portais de labirinto em seus galhos altos.&r"
		"Nem toda floresta antiga tem entradas para a Dimensão do Labirinto Élfico. Se você quiser achar a Árvore do Labirinto Élfico, talvez precise gastar um tempinho!"
	]
	quest.4835EBAC6D933CDB.quest_subtitle: "O índice de risco é alto e o EP é baixo (menos de 8000). Não vá, por favor!"
	quest.4835EBAC6D933CDB.title: "&6【História Principal•Terra dos Elfos】&rfloresta antiga"
	quest.48653257AF7891C8.quest_desc: "&6Você pode encontrar este lugar usando as coordenadas obtidas ao negociar com o Guardião do Tempo"
	quest.48653257AF7891C8.quest_subtitle: "Colapsar a si mesmo"
	quest.48849045FD239568.quest_desc: [
		"Pode ser encontrado em baús em terreno selvagem e em torres de magos. Claro, você também pode optar por fabricá-lo."
