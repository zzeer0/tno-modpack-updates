	quest.46F9C1A11397AF4E.quest_desc: [
		"Vincula a magia que o jogador aprendeu à varinha e ao livro de magia.&6(Somente magias elementais como fogo, água, vento, terra, espaço, gravidade, trovão e ondas sonoras, além de algumas magias de invocação, podem ser vinculadas)"
		""
		"&8Você pode fabricar uma você mesmo, ou encontrá-la na torre de mago ou no reino dos anões em terreno selvagem."
	]
	quest.46FF849AF3C24F9E.quest_subtitle: "Corpo completo, material perfeito para refino de remédios"
	quest.47945DBEFB4C8D26.quest_subtitle: "【Domínio】"
