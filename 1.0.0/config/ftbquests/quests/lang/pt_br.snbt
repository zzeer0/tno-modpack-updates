	]
	quest.48849045FD239568.quest_subtitle: "A base das ferramentas mágicas"
	quest.48C18EC1BD11BFFD.quest_desc: [
		"&8Encontrado ao lado do Fóssil de Osso no Inferno."
		"Depois de escavá-lo e deixá-lo de molho na água por cerca de 20 minutos, ele se transforma em um pequeno espírito maligno. Alimentá-lo com bolas de neve acelera seu crescimento."
	]
	quest.48C18EC1BD11BFFD.quest_subtitle: "chocando a alma musical"
	quest.48C51904019DBDE9.title: "Derrote a Flor do Vazio"
	quest.48EF9FC96BBC47AC.title: "Xamã Ogro"
	quest.4913736781F06A32.title: "{translate:\"task.D1E2F3A4B5C67891.title\"}"
	quest.49250178B975344D.quest_desc: [
		"&6Monstros podem se reproduzir através de comida! Basta alimentar dois monstros domados com o alimento certo para acasalá-los.&r"
		"Qualquer item comestível: Armorsauro, Aranha Negra, Aranha Blindada Perna-de-Lança"
		""
		"Carne, peixe, olho de aranha, olho de aranha fermentado, pé de coelho, cogumelo vermelho, cogumelo marrom: Formiga Demoníaca Gigante"
		""
		"Carne ou peixe: Demônio Cão, Basilisco, Tigre de Lâmina Única, Lobo Presa, Centopeia Maligna, Morcego Gigante, Bacalhau Gigante, Salmão Gigante, Lagarto Sanguessuga, Sisi, Touro Chifre-de-Lança, Serpente da Tempestade"
		""
		"Peixe: Lagarto Errante, Peixe Terrestre, Coruja Caolha"
		""
		"Flores: Abelha do Exército"
		""
		"Cenouras, cenouras douradas, dentes-de-leão e alimentos semelhantes: Coelho Chifrudo"
		""
		"Alimentos de Hipokute: Vaca-Cervo, Pégaso, Unicórnio"
		""
		"Carne, peixe ou carne de vaca-cervo: Urso Gigante, Urso Chifrudo"
		""
		"Beterraba, maçãs, batatas, cenouras: Pavão Dragão"
		""
		"Lã: Mariposa Infernal"
		""
		"&6Alguns monstros aparecem raramente, então mantê-los e criá-los é uma ótima escolha!&r"
	]
	quest.49250178B975344D.quest_subtitle: "Você sabia?"
