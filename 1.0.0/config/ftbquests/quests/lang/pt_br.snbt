	quest.5FFF9F5C6F8E18C8.quest_subtitle: "Talvez você precise destes comandos importantes?"
	quest.603A9A2A25A20537.quest_desc: "Atualmente ele aparece nas terras selvagens do Mundo Espiritual. Você pode ter a chance de encontrá-lo enquanto explora."
	quest.603A9A2A25A20537.quest_subtitle: "Um Chefe que existe no Mundo Espiritual"
	quest.609C124E1EAD39BA.quest_desc: "Você pode minerá-lo e decompô-lo em Cristais do Tempo"
	quest.609C124E1EAD39BA.title: "Isto é um tesouro"
	quest.60C0471AB7032E82.quest_desc: [
		"1. Domine 【Rei da Sabedoria: Raphael】 e seja um Lorde Demônio Verdadeiro ou Herói Verdadeiro."
		"2. Use o modo “Integração” de Raphael para absorver 5 Núcleos de Caríbdis."
		"3. Faça o modo “Refinamento” de Raphael produzir 64 itens no total."
		"4. Enquanto luta contra uma criatura não-aliada, esteja com menos de 25% de vida."
	]
	quest.60C0471AB7032E82.quest_subtitle: "Requisitos ↓"
	quest.60C0471AB7032E82.title: "&6【Superavançado】&f Habilidade Suprema: Manas Ciel"
	quest.60CAD3547CAF1AE2.quest_desc: "&6Tem 80% de chance de ser dropado por Hinata. &rSe você tiver Uriel, consumir 10 destes permite travar esta Habilidade Suprema na tela de \"Trava\", impedindo que seja perdida pela reencarnação."
	quest.60E49F02ABCAEB42.quest_desc: ["Há um buraco no chão para entrar no interior. O interior é organizado como um jogo da velha. Você precisa ir até o meio para achar a sala do Chefe."]
	quest.60E49F02ABCAEB42.quest_subtitle: "Fábrica enterrada no subsolo"
	quest.60E49F02ABCAEB42.title: "Descubra a Fundição de Marionetes"
