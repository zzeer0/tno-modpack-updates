	quest.52618536396B39A0.quest_desc: [
		"Obtenção"
		"Torne-se um Herói ou Lorde Demônio"
		""
		"&l[Ao Pressionar]&r"
		"Consome 1.000 Magículos e transforma o jogador em uma forma de tamanho humano. O tamanho original do corpo é restaurado após a morte."
	]
	quest.52618536396B39A0.quest_subtitle: "Mantenha sempre uma forma de tamanho humano"
	quest.52618536396B39A0.title: "&6[Avançado]&f Obtenha a Habilidade Forma Humana"
	quest.527C27144046597D.title: "Usado para fazer diversas plataformas de teletransporte"
	quest.52A30DD2FEEEAB9B.quest_desc: [
		"Absorve a Aura próxima para mudar o horário."
		""
		"Coloque o Relógio de Sol Mutável no chão, encoste uma Moldura de Item nele e insira o Ponteiro do Tempo na moldura. Clique com o botão direito para girá-lo até o horário desejado e então largue um Relógio na frente do bloco."
	]
	quest.52A30DD2FEEEAB9B.quest_subtitle: "A capacidade de alterar o tempo"
	quest.52E122FDA87AFC22.quest_desc: [
		"Ele acorda quando o jogador se aproxima. Tem dois estágios. No segundo estágio, as habilidades Golpe do Vazio e Golpe em Salto são desbloqueadas, e as habilidades do primeiro estágio são aprimoradas."
		"&6As habilidades que ele possui são: anulação de ataque espacial, anulação de ataque gravitacional, anulação de status anormal e fortalecimento corporal."
	]
