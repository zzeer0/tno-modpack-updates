	]
	quest.3B5B1BFC34011F6C.quest_desc: [
		"nascido na&5Nebulosa e no Caos&r, na fenda, um esquecido&bmar do nada&r，&4Fragmentos de memória quebrados&rCenas de continentes estranhos entram e saem da consciência..."
		" &8Você não pertence a este lugar, mas o destino te pregou aqui&r"
	]
	quest.3B5B1BFC34011F6C.quest_subtitle: "Que lugar é este?"
	quest.3B5B1BFC34011F6C.title: "Partir"
	quest.3B60B1CC41276A5D.quest_subtitle: "Um pouco mais fraco que a Armadura de Diamante"
	quest.3B60B1CC41276A5D.title: "Traje de formiga monstruosa"
	quest.3C348A1F46E6EDD3.quest_desc: ["Eles dormem no primeiro e no segundo andar da fortaleza. Depois de matá-los, eles dropam núcleos do vazio, que podem ser usados como armas ou fundidos com outros equipamentos na bigorna de fusão mecânica."]
	quest.3C348A1F46E6EDD3.quest_subtitle: "Guardião da Fortaleza"
	quest.3C348A1F46E6EDD3.title: "Derrote o golem do End"
	quest.3C4D5E6F7A8B9012.title: "{translate:\"task.3C4D5E6F7A8B9013.title\"}"
	quest.3C5160A9C279B5A9.quest_desc: [
		"Se você quiser obter a Semente de Lorde Demônio, o pré-requisito é ter&6200.000&rde EP, e ser da linhagem&5Demônio/Caos&r"
		""
		"&lO que dá para fazer com esta Semente de Lorde Demônio:&r"
		"&6- Você fica apto a despertar o Lorde Demônio.&r"
		"&6- Você desbloqueia a capacidade de coletar almas.&r"
	]
	quest.3C5160A9C279B5A9.quest_subtitle: "A Semente de Lorde Demônio é o estágio avançado do demônio. As almas dos seres vivos estão te atraindo."
