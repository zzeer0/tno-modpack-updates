	quest.5A54C9E87F1CE967.quest_desc: [
		"&#FFED54Hiperlink:&r"
		"[ { \"text\": \"Como Funcionam os Artefatos\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"4DB740093C0BA804\" } } ]"
		""
		"Efeitos Padrão"
		"&5Efeito 1: Encantamento Rápido"
		"Aumenta a velocidade de conjuração de magia em 10%."
		"Este efeito fica ativo enquanto o artefato estiver equipado e o efeito desbloqueado."
		"&5Efeito 2: Fluxo do Domínio"
		"Aumenta a velocidade de domínio de habilidades em 100%."
		"Este efeito fica ativo enquanto o artefato estiver equipado e o efeito desbloqueado."
		""
		"Bônus de Refinamento"
		"Escala do Encantamento Rápido"
		"Cada refinamento alocado em Encantamento Rápido aumenta a velocidade de conjuração em mais 2%."
		"Máximo: com +5 de refinamento, o Encantamento Rápido pode aumentar a velocidade de conjuração em até 20%."
		"Escala do Fluxo do Domínio"
		"Cada refinamento alocado em Fluxo do Domínio aumenta a velocidade de domínio em mais 10%."
		"Máximo: com +5 de refinamento, o Fluxo do Domínio pode aumentar a velocidade de domínio de habilidades em até 150%."
	]
