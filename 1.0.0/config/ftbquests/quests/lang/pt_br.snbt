	quest.576F41DB3BC82B6B.quest_desc: [
		"&lComo consegui-lo:&r"
		"Encontrado em cidades antigas (0,5%)"
		"Encontrado em ruínas de fortaleza e cidades do End (1%)"
		"Pode ser encontrado com certa probabilidade no castelo de Luminas."
