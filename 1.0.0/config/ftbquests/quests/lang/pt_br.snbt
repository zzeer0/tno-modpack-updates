	]
	quest.7621D7B84C9D710F.quest_subtitle: "Um meio raro de conjuração mágica"
	quest.7699A815D2FAA05D.quest_desc: ["Diferentes tipos de carvão espiritual reduzem o tempo de alquimia. A **Escritura da Pílula Suprema** é uma habilidade que também reduz o tempo de alquimia; depois de aprendê-la, você pode ativá-la com a tecla de habilidade."]
	quest.7699A815D2FAA05D.quest_subtitle: "Esta é a ferramenta mágica que você usa para refinar elixires."
	quest.76CF8528AD72AE60.quest_desc: ["É preciso pelo menos 1 lingote de ferro + 4 fragmentos de minério mágico para refinar um lingote de aço mágico inferior, então você vai precisar cavar muito minério mágico!"]
	quest.76CF8528AD72AE60.quest_subtitle: "Crie o metal mais forte..."
	quest.76CF8528AD72AE60.title: "&6【Linha de Forja·Importante】&rBarra de Ferro Repleta de Magículas"
