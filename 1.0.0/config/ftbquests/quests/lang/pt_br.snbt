		"&6&lGanhos Generosos【Desbloquear Codex】"
		"{image:ablazeaqzlcz:textures/ftb/curios/superstitious_hat.png width:50 height:80 align:left}"
	]
	quest.1EEA7724FA3BB72C.quest_subtitle: "arrebatar"
	quest.1F6166FE5D1FA206.quest_subtitle: "Castelo destruído por espíritos malignos"
	quest.1F894D1554FABD87.quest_desc: [
