	quest.4BA9724587B4D6FE.title: "Itens dropados ao derrotar o Demônio das Chamas"
	quest.4BC9A690FBB9F423.quest_desc: [
		"No topo da torre da Acrópole, você verá uma âncora no meio. Clique com o botão direito nela para invocar Cila, mas tome cuidado ao clicar."
		"&6Ela tem anulação de corrosão, anulação de status anormal, fortalecimento corporal e fortalecimento de aço."
		""
		"Ela tem três estágios. Cada vez que seu volume de sangue diminui em um terço, ela entra no próximo estágio."
	]
	quest.4BC9A690FBB9F423.quest_subtitle: "mulher segurando uma âncora"
	quest.4BC9A690FBB9F423.title: "Derrote a Sereia Scylla"
	quest.4BE26323EBBC3E2B.quest_subtitle: "Requer o Rei Élfico para desbloquear este ramo"
	quest.4C02AA6C31E0ECC6.quest_subtitle: "Ilha flutuante no End"
	quest.4CAB0E1CE150DBD9.quest_desc: "Este item é dropado ao matar um Orc Desastre ou um Lorde Orc"
	quest.4CAB0E1CE150DBD9.quest_subtitle: "O item mais precioso da raça Orc"
	quest.4D396C80A4183219.quest_desc: ["&7Ouvi dizer há muito tempo que existe uma ruína misteriosa escondida nas profundezas da antiga cidade subterrânea."]
