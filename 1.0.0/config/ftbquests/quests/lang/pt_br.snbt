	quest.7701D3E35582F91A.quest_desc: ["Uma fortaleza em uma ilha externa do End que pode ser encontrada através do Olho do Vazio."]
	quest.7701D3E35582F91A.quest_subtitle: "Construção isolada"
	quest.7701D3E35582F91A.title: "Vá até a fortaleza abandonada"
	quest.77209E7CA9027AA4.quest_desc: [
		"&6Observação: não use habilidades enquanto a cena estiver sendo exibida, pois isso pode limpar seus espaços de habilidade predefinidos."
