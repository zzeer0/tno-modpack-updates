	quest.77209E7CA9027AA4.quest_subtitle: "O selvagem congelado das montanhas nevadas"
	quest.77224F3957EF8057.quest_desc: [
		"Há duas maneiras de ir para a Dimensão Élfica: uma é reencarnar como raça Élfica, e o seu ponto de ressurreição passará a ser naquele mundo!"
		"Na Dimensão Élfica há muitas criaturas élficas, algumas curiosas e amigáveis com você. Claro, também há elfos hostis."
		""
		"E então, como voltar para o mundo principal?"
		""
		"&6Há condições adicionais para reencarnar em uma raça élfica e retornar ao mundo principal!"
	]
	quest.77224F3957EF8057.quest_subtitle: "ilustrar"
	quest.77224F3957EF8057.title: "Bem-vindo ao Mundo dos Elementais!"
	quest.774C400118E08DB2.title: "General Ogro"
