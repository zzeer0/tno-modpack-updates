	quest.1828789F09A9F162.title: "{translate:\"task.F6A7B8C9D0E12355.title\"}"
	quest.187252C941FBC59B.quest_desc: [
		"Fabrique a Fibra Brilhante e depois clique com o botão direito em folhas usando-a. Espere cerca de um dia no jogo para que virem Folhas Douradas, e então colha-as para obter a Folha de Ouro."
		""
		"&6Recomenda-se juntar pelo menos 20 Folhas de Ouro logo de início, pois rituais, altares e emblemas exigirão muitas delas mais adiante.&r"
	]
	quest.187252C941FBC59B.quest_subtitle: "Primeiros Passos"
