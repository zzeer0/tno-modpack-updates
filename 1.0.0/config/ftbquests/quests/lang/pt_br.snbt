	quest.224C89D395703D89.quest_desc: "Depois que um jogador devora um Forasteiro de Outro Mundo ou outro jogador com Gula ou Predador, ele passa a ter permanentemente o formato de Steve."
	quest.224C89D395703D89.quest_subtitle: "Sobre Minha Reencarnação Como Slime"
