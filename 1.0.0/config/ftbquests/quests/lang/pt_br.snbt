	quest.4A6D37AACDB09FA2.quest_desc: ["Assim que você passar de 10.000, 99% das áreas exploráveis serão desbloqueadas, e você desbloqueará Habilidades mais poderosas para se armar."]
	quest.4A6D37AACDB09FA2.title: "&6【História Principal】&rEP chega a 10.000"
	quest.4A98230B150A9D9A.quest_desc: "Construa uma moldura de portal parecida com um portal do Nether, depois fabrique uma \"Ampulheta do Tempo\" e clique com o botão direito no portal para ativá-lo e entrar na dimensão"
	quest.4A98230B150A9D9A.quest_subtitle: "Um mundo congelado por toda a eternidade"
