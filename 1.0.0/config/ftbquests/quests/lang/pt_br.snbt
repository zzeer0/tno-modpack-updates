	quest.03339785C2F33E9D.title: "【Cavaleiro de Ferro】Encarnação da Marionete"
	quest.033E7759B64F002C.quest_desc: [
		"Obtenção: use Absorver e Dissolver de um Slime, Predador, ou outra habilidade capaz de extrair as habilidades de um alvo em um Lagarto Flutuante, Lagarto Sanguessuga ou Serpente da Tempestade."
		""
		"&l[Passiva - Alternável]:&r Quando ativada, entidades marcadas como \"sangue quente\" num raio de 20 blocos ficam destacadas com contorno vermelho. Entidades marcadas como sangue frio não são exibidas, enquanto entidades marcadas como fontes de frio (como Golens de Neve) recebem contorno ciano. Não funciona no Nether."
	]
	quest.033E7759B64F002C.quest_subtitle: "Inimigo detectado no marcador"
	quest.033E7759B64F002C.title: "&6【Dica】&rObtenha 【Sentir Fonte de Calor】"
	quest.033ECFF9D28A7F31.quest_subtitle: "Alimente dragões macho e fêmea separadamente para que possam procriar"
	quest.03794AB92667475D.quest_desc: [
		"1. Requer 10.000.000 de EP."
		"2. Requer o domínio da Habilidade Única Adaptabilidade."
