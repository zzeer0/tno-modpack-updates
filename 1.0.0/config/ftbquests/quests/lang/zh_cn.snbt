	quest.139C40496643C9CC.quest_desc: ["拥有并精通【数学者】和【篡夺者】，玩家状态是真勇者或真魔王并且魔素达到500,000"]
	quest.139C40496643C9CC.quest_subtitle: "获得条件↓"
	quest.139C40496643C9CC.title: "&6【进阶类】&f究极技能 数奇之王·福尔图娜"
	quest.14AC04DF8CDFD067.quest_desc: [
		"&6你需要500万EP才能进入教堂中的传送门前往此维度"
		""
		"那里存在费尔德维，他是由星王龙维鲁达拿巴创造的“始源七天使”之一，也是其中最早诞生且实力极强的存在"
	]
