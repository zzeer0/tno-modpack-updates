	quest.7ED5AD8DF4A78DB0.quest_desc: [
		"一条盘踞在沼泽中的蛇，它住在半球形土墩。"
		"&6推荐使用带火焰附魔的武器攻击它！除非你能一击必杀"
	]
	quest.7ED5AD8DF4A78DB0.quest_subtitle: "为什么它只有三个头"
