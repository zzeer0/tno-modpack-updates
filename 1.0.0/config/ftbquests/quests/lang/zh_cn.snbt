	quest.0E105E703E79C81B.quest_desc: ["普通的魔法引擎可以半径16格不会刷新魔物，如果是迷宫魔法引擎则可以半径32格"]
	quest.0E105E703E79C81B.quest_subtitle: "降低周围的魔素浓度"
