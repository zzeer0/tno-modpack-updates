	quest.609C124E1EAD39BA.title: "这可是个宝贝"
	quest.60C0471AB7032E82.quest_desc: [
		"1.精通【智慧之王·拉斐尔】并且玩家为真魔王或者真勇者"
		"2.拉斐尔的“统合”模式吸收5个风暴大妖涡魔核"
		"3.拉斐尔的“提炼”模式累计产出64个物品"
		"4.与非友方生物战斗时，生命值严格低于 25%"
	]
	quest.60C0471AB7032E82.quest_subtitle: "获得条件↓"
	quest.60C0471AB7032E82.title: "&6【超进阶类】&f究极技能 玛纳斯·希耶尔"
	quest.60CAD3547CAF1AE2.quest_desc: ["&6由日向80%概率掉落&r在拥有乌列尔的情况下服用10个可在“锁定”界面将此究极技能上锁，防止转生丢失。"]
	quest.60E49F02ABCAEB42.quest_desc: ["在地面有洞口可以进入内部，内部像井字棋一样排列着，你需要前往最中间找到Boss房"]
	quest.60E49F02ABCAEB42.quest_subtitle: "埋在地下的工厂"
