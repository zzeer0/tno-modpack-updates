	quest.06D1B9E52BAEA193.title: "&6【基础材料】魔晶"
	quest.06D9CFEA57AC9827.quest_desc: [
		"&#FFED54超链接:&r"
		"[ { \"text\": \"饰品运作方式\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"4DB740093C0BA804\" } } ]"
		""
		"默认效果"
		"&5效果1：风行之速"
		"飞行速度提高15%。"
		"当装备该神器且效果已解锁时，此效果生效。"
		"&5效果2：至高之风"
		"风属性伤害提高25%。"
		"当装备该神器且效果已解锁时，此效果生效。"
		""
		"精炼增益"
		"御风移动缩放"
		"每分配给御风移动的一次精炼，都会使飞行速度额外提高5%。"
		"最大值：在+5精炼时，御风移动最多可使飞行速度提高40%。"
		"主权之风加成"
		"分配给主权之风的每次精炼，都会使风属性伤害额外提高5%。"
		"最大值：在精炼达到+5时，主权之风可使风属性伤害最高提高50%。"
	]
