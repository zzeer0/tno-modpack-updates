	quest.3B5B1BFC34011F6C.title: "开始启程"
	quest.3B60B1CC41276A5D.quest_subtitle: "比起钻石甲来说稍微弱了一点"
	quest.3B60B1CC41276A5D.title: "妖蚁套装"
	quest.3C348A1F46E6EDD3.quest_desc: ["他们沉睡在堡垒的一二层，击杀后会掉落虚空核心，可以当作武器使用也可以在机械融合砧中与其他装备进行融合"]
	quest.3C348A1F46E6EDD3.quest_subtitle: "堡垒守护者"
	quest.3C348A1F46E6EDD3.title: "击败末影傀儡"
	quest.3C5160A9C279B5A9.quest_desc: [
		"如果你想获得魔王种，前提是前有&620万&r的存在值（EP），并且本身为&5魔人/混沌&r"
		""
		"&l我获得这个魔王种能做的事：&r"
		"&6- 你拥有了觉醒魔王的资格。&r"
		"&6- 你解锁了收集灵魂的功能。&r"
	]
	quest.3C5160A9C279B5A9.quest_subtitle: "魔王种是魔人的进阶状态，生灵的灵魂吸引正着你"
	quest.3C5160A9C279B5A9.title: "&6【魔王线】&r获得魔王种子"
	quest.3D22913B4FB369F3.quest_subtitle: "概率掉落"
	quest.3D3F898FE129112A.quest_desc: [
		"该结构生成在沙漠中，可以通过沙漠之眼寻找到"
