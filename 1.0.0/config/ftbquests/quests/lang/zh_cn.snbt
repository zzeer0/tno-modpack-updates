	quest.1D870390E22D0E28.quest_subtitle: "我想煲汤喝"
	quest.1DE8784B7276EDA8.title: "&6【小支线】&r还要强！更快"
	quest.1DF55B2C88B9B888.quest_desc: [
		"能够更加快速的喝完药水"
		"&6&l快速饮用【解锁图鉴】"
