	quest.14DF20843C746694.quest_subtitle: "塔上妖王"
	quest.15009A4C69307199.quest_desc: ["&6由利姆露80%概率掉落&r在拥有暴食之王的情况下服用10个可在“锁定”界面将此究极技能上锁，防止转生丢失。"]
	quest.15009A4C69307199.quest_subtitle: "将此技能保持状态"
	quest.15B40702B126BC7E.quest_desc: [
		"将&l【暴风大妖涡魔核】&r放在刷怪区域，并击杀怪物为其提供存在值。"
		"可使用技能查看或挖下查看EP，当EP达到10w时，会开始发光并发出异响。"
		"此时右键即可孵化&l【卡律布狄斯】&r"
	]
	quest.15B40702B126BC7E.quest_subtitle: "召唤？"
	quest.15B40702B126BC7E.title: "寻找并击杀暴风大妖--涡卡律布狄斯"
