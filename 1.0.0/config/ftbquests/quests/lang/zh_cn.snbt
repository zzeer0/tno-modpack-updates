	quest.3DAA0D096C085183.title: "土精灵•中阶"
	quest.3DE59F19B491EDC7.quest_desc: [
		"&6如果你兑换了独特技能，使用后将会消耗灵魂能量"
		"[ { \"text\": \"灵魂能量\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"0FDA8DE439A0FC25\" } } ]"
		""
		"&6如果你使用了人物重置卷并且没有锁定技能，技能会消失"
		"[ { \"text\": \"锁定技能\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"166F39FFE1C98A63\" } } ]"
	]
	quest.3DE59F19B491EDC7.quest_subtitle: "注意事项"
	quest.3DE59F19B491EDC7.title: "&#A9FFF5【兑换】&f独特技能"
	quest.3EBFD5237BAC875A.quest_subtitle: "合成材料"
	quest.3F92724DDA398BAB.quest_desc: [
		"&6你不能直接打死【严厉】；你要在【杀戮之罪】被宣判的回合里，把“审判之鸟”骗进定身陷阱，再诱导【严厉】用【净化激光】亲手杀掉鸟，让它自己“犯罪”它每“犯罪”一次，Boss血条就减 1。&6减满 10 次，它才会死。"
		""
		""
		"它真正的“血条”不是生命，而是严厉还能犯下多少次【罪行】初始是10每让它成功“犯罪”一次，血条 -1当它累计犯罪 ≥ 5 时，进入二阶段"
		""
		"所以这场战斗本质上不是“输出战”，而是："
		"设计一个局，让 Boss 自己违规。"
		""
		"【杀戮之罪】是你的输出回合"
		"本轮里，杀死任何实体都会让击杀者【罪行】+1"
		"这是唯一能让严厉掉血的回合"
		"因为你可以让它去杀 审判之鸟"
		"优先盯审判之鸟把鸟往定身陷阱那边带让鸟被绑住再等/引导严厉放净化激光"
	]
	quest.3F92724DDA398BAB.title: "击败严厉"
	quest.3F98657DFD336347.quest_desc: [
		"从小穿到大的装备出现了！"
		"&3下级魔钢（18k存在值）->&r"
		"&b上级魔钢（52k存在值）->&r"
		"&5纯魔钢（225k存在值）->&r"
		"&d生体魔钢（750k存在值）&r-> &4究极金属&r"
		""
		"和魔物皮革一致，都能进行进化"
	]
	quest.3F98657DFD336347.quest_subtitle: "治炼锻造之术"
	quest.3F98657DFD336347.title: "&6【锻造线•重要】&r正确包裹自己！"
	quest.3FF9F50B6BD99394.quest_desc: [
		"反伤将敌人毒倒"
		"&6&l剧毒防御【解锁图鉴】"
