	quest.3A597A26AAFD54B9.quest_desc: [
		"[ { \"text\": \"了解矮人声望系统\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"56413501A9E9D8FC\" } } ]"
		""
		"达到指定声望即可通过此门前往矮人首领的挑战房"
	]
	quest.3A597A26AAFD54B9.quest_subtitle: "矮人制作的尖端科技"
	quest.3A9101C87B524BD3.quest_desc: [
		"&6魔杖蓝图"
		"（10 金币）在矮人魔法师那里兑换（大师级）"
	]
	quest.3B5B1BFC34011F6C.quest_desc: [
		"        诞生于&5星云与混沌&r的间隙，一片被遗忘的&b虚无之海&r，&4破碎的记忆残片&r与陌生大陆的景象在意识中浮沉......"
		" &8       你本不属于此地，可命运却将你牢牢钉在此处&r"
		""
		"&4⌈系统⌋"
		"注意！在游戏前两天内，长手蜥蜴、彷徨蜥蜴、犬魔和牙狼刷新率会没那么高哦！"
	]
