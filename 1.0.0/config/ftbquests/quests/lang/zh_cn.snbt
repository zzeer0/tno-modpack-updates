	quest.6190955DF040A782.quest_subtitle: "通过转生或者其他方式获得"
	quest.6190955DF040A782.title: "&6【进阶类】&f获得变质者独特技能"
	quest.61D5F38862A9CCFB.quest_desc: [
		"&6击杀魔物有概率掉落该材料&r"
