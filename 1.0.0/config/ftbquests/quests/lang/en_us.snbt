	quest.6BC22C266AD65BED.quest_desc: [
		"&#FFED54Hyperlink:&r"
		"[ { \"text\": \"How Artifacts Work\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"4DB740093C0BA804\" } } ]"
		""
		"Default Effects"
		"&5Effect 1: Magic Bullet Acceleration"
		"Increases the maximum charge speed of Magic Bullet to 3×."
		"This effect is active while the artifact is equipped and the effect is unlocked."
		"&5Effect 2: Ogre's Wrath"
		"When the wearer's HP is at or below 25%, Physical Damage is increased by 15%."
		"This effect is active while the artifact is equipped and the effect is unlocked."
		""
		"Refinement Bonuses"
		"Magic Bullet Acceleration Scaling"
		"Each refinement allocated to Magic Bullet Acceleration increases Magic Bullet's maximum charge speed by an additional 1×."
		"Maximum: Magic Bullet Acceleration can receive up to 2 refinements, increasing Magic Bullet's maximum charge speed to 5×."
		"Ogre's Wrath Scaling"
		"Each refinement allocated to Ogre's Wrath increases the Physical Damage bonus by an additional 2.5%."
		"Maximum: Ogre's Wrath can receive up to 2 refinements, increasing Physical Damage by up to 20% while HP is at or below 25%."
	]
	quest.6BC22C266AD65BED.title: "&6【Artifact】&fGrade 2 Ancient Artifact"
	quest.6BF28FAF8EB4389A.quest_desc: [
