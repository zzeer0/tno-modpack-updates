	quest.777523E00372E128.quest_subtitle: "Absorb nearby flowers and convert them into Aura"
	quest.78465B68CA53F4C8.quest_desc: ["Dropped by the Sirens in the Acropolis"]
	quest.78465B68CA53F4C8.quest_subtitle: "Priceless"
	quest.78465B68CA53F4C8.title: "tears of sirens"
	quest.78B7C0A0CB97647C.quest_desc: [
		"A powerful existence above ordinary demons and below the Lord Demon."
		"Great demons usually possess extremely high magic power and wisdom, are able to skillfully use powerful magic and spiritual abilities, and belong to the dominant class in hell."
	]
	quest.78B7C0A0CB97647C.quest_subtitle: "Intelligent body"
	quest.78B7C0A0CB97647C.title: "big devil"
	quest.7918A54B2D2DA0B7.quest_subtitle: "The skin is very thick and very durable"
	quest.7918A54B2D2DA0B7.title: "Heavy armored lizard monster"
	quest.792137DE82A20891.quest_desc: [
		"&6Note: Do not use skills while the cutscene is playing, as it may cause your preset skill slots to be cleared."
		""
		""
		"Completely invincible during attack animations, can also reflect arrows."
		"When hit outside of attack, it loses \"paralysis value\". It enters paralysis after 4 hits by default."
		"There is no damage reduction during paralysis, this is the best window for dealing damage."
		"Recovers after about 2 seconds, resetting the paralysis value."
	]
	quest.792137DE82A20891.quest_subtitle: "The best in the Nether"
	quest.7A20976135887AD4.quest_desc: [
		"Master both [Great Sage] and [Degenerate]. The player's race must be Hero's Egg / True Hero or Demon Lord's Egg / True Demon Lord."
		""
		"In multiplayer, only one player may own this skill. To remove this restriction, use /gamerule raphaelTrulyUnique false"
	]
	quest.7A20976135887AD4.quest_subtitle: "Requirements↓"
	quest.7A20976135887AD4.title: "&6【Advanced】&fUltimate Skill Raphael"
	quest.7A8B9C0D1E2F3456.title: "{translate:\"task.7A8B9C0D1E2F3457.title\"}"
	quest.7B060096CAC00AFF.quest_desc: [
		"1. Master Infinite Prison (it will not be lost)"
		"2. Requires 2,000,000 Magicules, which will be consumed during evolution"
		"3. Be either a True Demon Lord or a True Hero"
	]
	quest.7B060096CAC00AFF.quest_subtitle: "Acquisition Requirements ↓"
	quest.7B060096CAC00AFF.title: "&6【Advanced】&fUltimate Skill: Chronairos, Lord of Eternity"
	quest.7B3CB2920C4FA0A0.quest_desc: ["A terrifying fortress built by piglins in the Nether, which can be found with the Eye of the Beast."]
	quest.7B3CB2920C4FA0A0.quest_subtitle: "war puppet manufacturing base"
	quest.7B3CB2920C4FA0A0.title: "Go to Soul Forge"
	quest.7B554FD6836AC9B8.title: "{translate:\"task.DD4E5F6A7B8C9013.title\"}"
	quest.7B57FB93AA91033C.quest_subtitle: "Probability of dropping"
	quest.7B94E2CB1A399EA7.quest_subtitle: "Choose this route to craft talismans"
	quest.7BD3A28C97D7CA72.title: "&6【Main Story】&rEP reaches 400,000"
	quest.7C0112271677EE1D.quest_desc: [
		"1. Defeat the Ender Dragon"
		"2. Master either [Wind Manipulation] or [Wind Domination]"
		"3. Have 400,000 Magicule"
		""
		"In multiplayer, only one player may own this skill. To remove this restriction, use /gamerule VeldoraTrulgUnique false"
	]
	quest.7C0112271677EE1D.quest_subtitle: "Acquisition requirements ↓"
	quest.7C0112271677EE1D.title: "&6[Advanced]&fUltimate Skill Veldora, Lord of Storm"
	quest.7CAE60C40150CCBE.quest_subtitle: "You need to become a Demon Lord [See Main Story for details]"
	quest.7CD7FD7FA288E4E6.quest_desc: [
		"Find Orc and you're halfway there!"
		""
		"&lThey are usually found in deserts and you can easily encounter them in the desert&r"
	]
	quest.7CD7FD7FA288E4E6.quest_subtitle: "Is there such a creature in the endless desert?"
	quest.7D000AE461BC6886.quest_desc: [
		"On the right side of the character model (in the red box of the picture) you can see the text for selecting evolution. After clicking to enter the interface, you can see the evolution goal on the right side and the conditions for evolution on the lower right side.&lIf there are many evolution conditions, remember to scroll down with your mouse wheel to check. Don’t miss any information."
		""
		"{image:ablazeaqzlcz:textures/ftb/personal_panel_3.png width:80 height:80 align:center}"
		"The current conditions are divided into the following categories:"
		""
		"1. Obtain EP(EP)"
		"&6EP is obtained by killing monsters. Under normal circumstances, 3% of the EP value of the killed monster is obtained."
		"&r"
		"2. Consume [item]"
		"&6You need to right-click the item to eat it (most of it). If it cannot be eaten, you usually need to use the Absorption and Dissolution Skill to hold the corresponding item and press the Skill key.&r"
		""
		"3. Kill the leader/Boss"
		"&6Can be any Boss&4But not repeatable&6"
		""
		"{@pagebreak}"
		"4. Get an elf"
		"&6You need to go to the Elf Maze Tree to get any elemental elf.&r"
		""
		"5. Become [True Demon Lord/True Hero]"
		"&5True Demon Lord evolution requirements"
		"&r0. He is a Demon/Chaos and is a Demon Lord Seed"
		"1. Obtain 1w soul (2k EP = 1 soul, need to reach 20wEP (Demon Lord Seed is also automatically obtained after 20wEP) and then kill the creature to obtain the soul)"
		"2. And click the Awakening button on the left side of the race interface"
		"3. Only effective for Demon Lord Seed"
		"If the evolution button is not displayed after meeting the conditions, you can enter the command to evolve: /evolve demonlord"
		"&6True Brave Evolution Conditions Required"
		"&r0. Itself is a creature/chaos"
		"1. After contracting with 6 high-level elves, they will grow into brave eggs."
		"2. Have a hero egg, and after reaching 400,000 or more EP, you can become it when you only have 20% health left to fight Hinata or the Great Demon Whirlpool, or you can use the hero scroll redeemed through the Main Story mission (you also need a hero egg)."
		""
		"6. Proficient [Skill]"
		"&6You need to acquire and use this Skill until you become proficient.&r(This goal is rare)"
		""
		"7. Have a name"
		"&61. Press Shift+N to turn on Soul Eater naming (True)&r"
		"&62. Kill 1,000 Humans (witches, villagers, raiders, aliens) or complete 25 raids by raiders."
		"&64. The soul will be automatically named after the conditions are met."
		"&6Note: Turning off naming will not make the number of kills disappear, only deaths will."
		"&6View the command: [/tensura get awakening [TAB complete your name] humanKill]"
	]
	quest.7D000AE461BC6886.title: "Race and Evolution"
	quest.7D00E143DC7B8D9E.quest_desc: [
		"The first step is to open the backpack with the E key and see the \"green map\" icon in the upper left corner."
		"{image:ablazeaqzlcz:textures/ftb/chunk_map.png width:130 height:130 align:center}"
		"Click on it, then find the block you want to force load, left-click once, then SHIFT+left-click and click on it again to force-load the block, and right-click to remove the declared block (including removing forced loading)"
	]
	quest.7D00E143DC7B8D9E.quest_subtitle: "Loading chunks!"
	quest.7D00E143DC7B8D9E.title: "How to force block loading"
