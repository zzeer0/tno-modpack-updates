	quest.06D1B9E52BAEA193.title: "&6【Basic Material】Magic Crystal"
	quest.06D9CFEA57AC9827.quest_desc: [
		"&#FFED54Hyperlink:&r"
		"[ { \"text\": \"How Artifacts Work\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"4DB740093C0BA804\" } } ]"
		""
		"Default Effects"
		"&5Effect 1: Windborne Movement"
		"Increases flight speed by 15%."
		"This effect is active while the artifact is equipped and the effect is unlocked."
		"&5Effect 2: Sovereign Wind"
		"Increases Wind damage by 25%."
		"This effect is active while the artifact is equipped and the effect is unlocked."
		""
		"Refinement Bonuses"
		"Windborne Movement Scaling"
		"Each refinement allocated to Windborne Movement increases flight speed by an additional 5%."
		"Maximum: At +5 refinement, Windborne Movement can increase flight speed by up to 40%."
		"Sovereign Wind Scaling"
		"Each refinement allocated to Sovereign Wind increases Wind damage by an additional 5%."
		"Maximum: At +5 refinement, Sovereign Wind can increase Wind damage by up to 50%."
	]
	quest.06D9CFEA57AC9827.title: "&6【Artifact】&fGrade 2 Ancient Artifact"
