	quest.166F39FFE1C98A63.quest_desc: [
		"Allows you to lock a configured Skill. Once the Skill is locked, the player can retain the Skill even if the character is reset."
		"{image:ablazeaqzlcz:textures/ftb/lock.png width:100 height:122 align:center}"
		""
		"The number of locks depends on the soul level."
		"1 level 1-2"
		"2 for level 3-5"
		"3 above level 6"
		""
