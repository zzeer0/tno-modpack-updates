	quest.263A8208AA5CCDA6.quest_desc: [
		"&#FFED54Hyperlink:&r"
		"[ { \"text\": \"How Artifacts Work\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"4DB740093C0BA804\" } } ]"
		""
		"Default Effects"
		"&5Effect 1: Magicule Efficiency"
		"Reduces the MP/Magicule cost of magic by 10%."
		"This effect is active while the artifact is equipped and the effect is unlocked."
		""
		"Refinement Bonuses"
		"Each refinement increases the reduction to magic MP/Magicule costs by an additional 1%."
		"Maximum: At +10 refinement, Magicule Efficiency can reduce magic MP/Magicule costs by 20%."
	]
