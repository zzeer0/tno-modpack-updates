	quest.2DE2EA8E74C55722.title: "&6【Brave Line】&rObtain the hero egg"
	quest.2E0D203C4166C35C.quest_desc: ["The main function of the reincarnation essence is as a threshold resource for reincarnation. Only when the reincarnation essence meets the requirements, the player will be eligible for reincarnation. The reincarnation essence will be cleared after the reincarnation is completed. The amount of reincarnation essence required for each reincarnation will increase with the number of reincarnations."]
	quest.2E0D203C4166C35C.quest_subtitle: "Can only be obtained by completing honorary commissions"
	quest.2E3BE90938EB4D75.quest_subtitle: "Probability of dropping"
	quest.2E52B4F14A7EE943.quest_desc: ["Dragon eggs can be dropped by female flying dragons whose growth stage reaches level 4 and above, and the number ranges from 0 to 3.&6All are generated underground."]
	quest.2E52B4F14A7EE943.quest_subtitle: "The dragons on the ground are too small!"
